<?xml version="1.0"?>
<robot name="quadrotor">

  <!-- Dummy links and joints -->
  <link name="world">

  <joint name="floating_base" type="floating">
    <parent link="world">
    <child link="base_link">
  </joint>

  <!-- Base -->
  <link name="base_link">
    <inertial>
      <mass value="1.5"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.02" iyy="0.02" izz="0.04"
               ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>

    <visual>
      <geometry>
        <box size="0.3 0.3 0.1"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision>
      <geometry>
        <box size="0.3 0.3 0.1"/>
      </geometry>
    </collision>
  </link>

  <!-- Brazos -->
  <link name="arm_1"/>
  <link name="arm_2"/>
  <link name="arm_3"/>
  <link name="arm_4"/>

  <!-- Motores -->
  <link name="rotor_1"/>
  <link name="rotor_2"/>
  <link name="rotor_3"/>
  <link name="rotor_4"/>

  <!-- Joints brazos -->
  <joint name="joint_arm_1" type="fixed">
    <parent link="base_link"/>
    <child link="arm_1"/>
    <origin xyz="0.2 0 0"/>
  </joint>

  <joint name="joint_arm_2" type="fixed">
    <parent link="base_link"/>
    <child link="arm_2"/>
    <origin xyz="-0.2 0 0"/>
  </joint>

  <joint name="joint_arm_3" type="fixed">
    <parent link="base_link"/>
    <child link="arm_3"/>
    <origin xyz="0 0.2 0"/>
  </joint>

  <joint name="joint_arm_4" type="fixed">
    <parent link="base_link"/>
    <child link="arm_4"/>
    <origin xyz="0 -0.2 0"/>
  </joint>

  <!-- Joints rotores -->
  <joint name="joint_rotor_1" type="continuous">
    <parent link="arm_1"/>
    <child link="rotor_1"/>
    <origin xyz="0.1 0 0"/>
  </joint>

  <joint name="joint_rotor_2" type="continuous">
    <parent link="arm_2"/>
    <child link="rotor_2"/>
    <origin xyz="-0.1 0 0"/>
  </joint>

  <joint name="joint_rotor_3" type="continuous">
    <parent link="arm_3"/>
    <child link="rotor_3"/>
    <origin xyz="0 0.1 0"/>
  </joint>

  <joint name="joint_rotor_4" type="continuous">
    <parent link="arm_4"/>
    <child link="rotor_4"/>
    <origin xyz="0 -0.1 0"/>
  </joint>

</robot>